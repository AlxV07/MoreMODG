{
  "manifest_version": 3,
  "name": "MoreMODG",
  "version": "0.2.0",
  "description": "Student-built enhancements to the family portal!",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://families.modg.org/*"
  ],
  "icons": {
    "16": "moremodg-logo-16.png",
    "32": "moremodg-logo-32.png",
    "48": "moremodg-logo-48.png",
    "128": "moremodg-logo-128.png"
  },
  "action": {
    "default_title": "MoreMODG",
    "default_icon": {
      "16": "moremodg-logo-16.png",
      "32": "moremodg-logo-32.png",
      "48": "moremodg-logo-48.png",
      "128": "moremodg-logo-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://families.modg.org/students/*",
        "https://families.modg.org/students/*/studentwork",
        "https://families.modg.org/syllabi/*",
        "https://families.modg.org/customsyllabi/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
